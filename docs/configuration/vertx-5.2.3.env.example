# HTTPS_KEYSTORE — Keystore path; format inferred from extension unless HTTPS_KEYSTORE_TYPE is set.
# environment-only; default: none; without annotation: empty
# HTTPS_KEYSTORE=

# HTTPS_KEYSTORE_PASSWORD — Keystore password; configure externally.
# environment-only; default: none; without annotation: empty (PFX), changeit (JKS)
# HTTPS_KEYSTORE_PASSWORD=

# HTTPS_KEYSTORE_TYPE — JKS, PKCS12 or PFX; empty infers from file extension.
# environment-only; default: none; without annotation: auto
# HTTPS_KEYSTORE_TYPE=

# OTEL_EXPORTER_OTLP_ENDPOINT — Shared OTLP base URL; overrides TELEMETRY_OTLP_ENDPOINT.
# environment-only; default: none; without annotation: TELEMETRY_OTLP_ENDPOINT
# OTEL_EXPORTER_OTLP_ENDPOINT=

# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT — Complete logs URL; precedes TELEMETRY_LOGS_ENDPOINT, then shared base + /v1/logs.
# environment-only; default: none; without annotation: derived from shared base
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=

# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT — Complete traces URL; precedes TELEMETRY_TRACES_ENDPOINT, then shared base + /v1/traces.
